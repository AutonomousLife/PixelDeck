From: PixelDeck contributors
Subject: [PATCH] wsi: opt-in per-thread presentation stage timings

Default off; no synchronization or result changes. Apply after cached WSI
and native DMA-BUF patches. Counters describe calls, not displayed frames;
total includes the nested stage times. Log one batch per 240 presents.

--- a/src/vulkan/wsi/wsi_common.c
+++ b/src/vulkan/wsi/wsi_common.c
@@ -41,6 +41,8 @@
 #include "vk_util.h"
 
 #include <assert.h>
+#include <errno.h>
+#include "c11/threads.h"
 #include <time.h>
 #include <stdlib.h>
 #include <stdio.h>
@@ -50,6 +52,91 @@
 #endif
 
 uint64_t WSI_DEBUG;
+
+/* Pixel presentation diagnostics: aggregate on the presenting thread only. */
+DEBUG_GET_ONCE_BOOL_OPTION(pixel_present_timing, "PANVK_KBASE_PRESENT_TIMING", false)
+
+enum pixel_present_stage {
+   PIXEL_PRESENT_THROTTLE,
+   PIXEL_PRESENT_SUBMIT,
+   PIXEL_PRESENT_BLIT,
+   PIXEL_PRESENT_FENCE,
+   PIXEL_PRESENT_INVALIDATE,
+   PIXEL_PRESENT_BACKEND,
+   PIXEL_PRESENT_TOTAL,
+   PIXEL_PRESENT_STAGE_COUNT,
+};
+
+static thread_local struct {
+   struct {
+      uint64_t count, ns, max_ns, errors;
+   } stages[PIXEL_PRESENT_STAGE_COUNT];
+   unsigned batch;
+} pixel_present_stats;
+
+static bool
+pixel_present_enabled(void)
+{
+   int saved_errno = errno;
+   bool enabled = debug_get_option_pixel_present_timing();
+   errno = saved_errno;
+   return enabled;
+}
+
+static uint64_t
+pixel_present_begin(bool enabled)
+{
+   if (!enabled)
+      return 0;
+   int saved_errno = errno;
+   uint64_t now = os_time_get_nano();
+   errno = saved_errno;
+   return now;
+}
+
+static void
+pixel_present_end(enum pixel_present_stage stage, uint64_t start, VkResult result)
+{
+   if (!start)
+      return;
+   int saved_errno = errno;
+   uint64_t ns = os_time_get_nano() - start;
+   pixel_present_stats.stages[stage].count++;
+   pixel_present_stats.stages[stage].ns += ns;
+   pixel_present_stats.stages[stage].max_ns =
+      MAX2(pixel_present_stats.stages[stage].max_ns, ns);
+   pixel_present_stats.stages[stage].errors += result < 0;
+
+   if (stage == PIXEL_PRESENT_TOTAL &&
+       pixel_present_stats.stages[stage].count == 240) {
+      static const char *names[] = {
+         "throttle", "submit", "blit", "fence", "invalidate", "backend", "total",
+      };
+      /* One write keeps concurrent threads' batch records together. */
+      char line[1536];
+      long pid = 0;
+#ifndef _WIN32
+      pid = (long)getpid();
+#endif
+      int used = snprintf(line, sizeof(line),
+                          "PIXEL_PRESENT pid=%ld thread=%p batch=%u",
+                          pid, (void *)&pixel_present_stats,
+                          ++pixel_present_stats.batch);
+      for (unsigned i = 0; i < PIXEL_PRESENT_STAGE_COUNT; i++) {
+         used += snprintf(line + used, sizeof(line) - used,
+                          " %s=%llu/%llu/%llu/%llu", names[i],
+                          (unsigned long long)pixel_present_stats.stages[i].count,
+                          (unsigned long long)(pixel_present_stats.stages[i].ns / 1000),
+                          (unsigned long long)(pixel_present_stats.stages[i].max_ns / 1000),
+                          (unsigned long long)pixel_present_stats.stages[i].errors);
+      }
+      fprintf(stderr, "%s units=count/us/max_us/errors\n", line);
+      memset(pixel_present_stats.stages, 0, sizeof(pixel_present_stats.stages));
+   }
+   errno = saved_errno;
+}
+/* End Pixel presentation diagnostics. */
+
 
 static const struct debug_control debug_control[] = {
    { "buffer",       WSI_DEBUG_BUFFER },
@@ -2459,6 +2546,8 @@
                          struct vk_queue *queue,
