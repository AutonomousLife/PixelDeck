From: PixelDeck contributors
Subject: [PATCH] panvk: opt in to X11 MIT-SHM CPU copies without host import

Apply after panvk-cached-wsi.patch. PANVK_KBASE_SHM_COPY=1 enables a
separate SysV SHM copy for kbase CPU WSI without EXT_external_memory_host.
GPU readback allocations, present fences and cache invalidation are unchanged.
Use full-frame ShmPutImage, then a geometry reply before image reuse; socket
PutImage remains the fallback if SHM allocation or checked attach fails.
MESA_VK_WSI_DEBUG=noshm still disables this path. Default remains off.

--- a/src/vulkan/wsi/wsi_common.h
+++ b/src/vulkan/wsi/wsi_common.h
@@ -143,6 +143,9 @@
        * dma-buf with modifier 1274 through PixmapFromBuffers.
        */
       bool use_raw_fd_modifier;
+
+      /* Copy CPU readback into separate MIT-SHM; no Vulkan host import. */
+      bool use_shm_copy;
 
       /* Never report VK_SUBOPTIMAL_KHR. Used to workaround
        * games that cannot handle SUBOPTIMAL correctly. */
--- a/src/panfrost/vulkan/panvk_wsi.c
+++ b/src/panfrost/vulkan/panvk_wsi.c
@@ -101,6 +101,12 @@
       !physical_device->wsi_device.has_import_memory_host &&
       cached_wsi && !strcmp(cached_wsi, "1");
 
+   const char *shm_copy = getenv("PANVK_KBASE_SHM_COPY");
+   physical_device->wsi_device.x11.use_shm_copy =
+      uses_kbase && physical_device->wsi_device.sw &&
+      !physical_device->wsi_device.has_import_memory_host &&
+      shm_copy && !strcmp(shm_copy, "1");
+
    /* kbase is not a DRM fd.  The default CPU WSI path presents through
     * MIT-SHM.  Android dma-heaps can also provide shareable
     * allocations, but some Android X servers advertise DRI3 while rejecting
--- a/src/vulkan/wsi/wsi_common_x11.c
+++ b/src/vulkan/wsi/wsi_common_x11.c
@@ -40,6 +40,7 @@
 #include <stdio.h>
 #include <unistd.h>
 #include <errno.h>
