+++ b/src/vulkan/wsi/wsi_deferred_present.h
@@ -0,0 +1,145 @@
+/* Experimental CPU-complete publication worker. No external fence export. */
+#ifndef WSI_DEFERRED_PRESENT_H
+#define WSI_DEFERRED_PRESENT_H
+#include "c11/threads.h"
+#include <stdlib.h>
+#include <string.h>
+struct wsi_deferred_job {
+   uint32_t image;
+   VkPresentRegionKHR damage;
+   VkRectLayerKHR *rectangles;
+};
+struct wsi_deferred_worker {
+   mtx_t lock;
+   cnd_t changed;
+   thrd_t thread;
+   bool initialized, stopping;
+   unsigned head, count, capacity;
+   VkResult error;
+   void *data;
+   struct wsi_deferred_job *jobs;
+   VkResult (*prepare)(void *, uint32_t);
+   VkResult (*publish)(void *, uint32_t, const VkPresentRegionKHR *);
+   void (*finished)(void *, uint32_t);
+};
+static int
+wsi_deferred_run(void *arg)
+{
+   struct wsi_deferred_worker *w = arg;
+   for (;;) {
+      mtx_lock(&w->lock);
+      while (!w->count && !w->stopping)
+         cnd_wait(&w->changed, &w->lock);
+      if (!w->count) {
+         mtx_unlock(&w->lock);
+         return 0;
+      }
+      struct wsi_deferred_job job = w->jobs[w->head];
+      w->head = (w->head + 1) % w->capacity;
+      w->count--;
+      VkResult earlier_error = w->error;
+      mtx_unlock(&w->lock);
+      /* Drain real GPU waits even following an earlier publication error. */
+      VkResult result = w->prepare(w->data, job.image);
+      if (result == VK_SUCCESS && earlier_error == VK_SUCCESS)
+         result = w->publish(w->data, job.image,
+                             job.rectangles ? &job.damage : NULL);
+      free(job.rectangles);
+      mtx_lock(&w->lock);
+      if (result != VK_SUCCESS && result != VK_SUBOPTIMAL_KHR &&
+          w->error == VK_SUCCESS)
+         w->error = result;
+      mtx_unlock(&w->lock);
+      w->finished(w->data, job.image);
+   }
+}
+static bool
+wsi_deferred_init(struct wsi_deferred_worker *w, unsigned capacity, void *data,
+                  VkResult (*prepare)(void *, uint32_t),
+                  VkResult (*publish)(void *, uint32_t, const VkPresentRegionKHR *),
+                  void (*finished)(void *, uint32_t))
+{
+   if (!capacity)
+      return false;
+   w->jobs = calloc(capacity, sizeof(*w->jobs));
+   if (!w->jobs)
+      return false;
+   if (mtx_init(&w->lock, mtx_plain) != thrd_success)
+      goto fail_jobs;
+   if (cnd_init(&w->changed) != thrd_success)
+      goto fail_lock;
+   w->capacity = capacity;
+   w->data = data;
+   w->prepare = prepare;
+   w->publish = publish;
+   w->finished = finished;
+   w->error = VK_SUCCESS;
+   if (thrd_create(&w->thread, wsi_deferred_run, w) != thrd_success)
+      goto fail_cond;
+   w->initialized = true;
+   return true;
+fail_cond:
+   cnd_destroy(&w->changed);
+fail_lock:
+   mtx_destroy(&w->lock);
+fail_jobs:
+   free(w->jobs);
+   w->jobs = NULL;
+   return false;
+}
+static VkResult
+wsi_deferred_error(struct wsi_deferred_worker *w)
+{
+   if (!w->initialized)
+      return w->error;
+   mtx_lock(&w->lock);
+   VkResult result = w->error;
+   mtx_unlock(&w->lock);
+   return result;
+}
+static void
+wsi_deferred_finish(struct wsi_deferred_worker *w)
+{
+   if (!w->initialized)
+      return;
+   mtx_lock(&w->lock);
+   w->stopping = true;
+   cnd_broadcast(&w->changed);
+   mtx_unlock(&w->lock);
+   thrd_join(w->thread, NULL);
+   w->initialized = false;
+   cnd_destroy(&w->changed);
+   mtx_destroy(&w->lock);
+   free(w->jobs);
+   w->jobs = NULL;
+}
+static bool
+wsi_deferred_enqueue(struct wsi_deferred_worker *w, uint32_t image,
+                     const VkPresentRegionKHR *damage)
+{
+   struct wsi_deferred_job job = {0};
+   job.image = image;
+   if (damage && damage->rectangleCount && damage->pRectangles) {
+      size_t bytes = (size_t)damage->rectangleCount * sizeof(VkRectLayerKHR);
+      if (bytes / sizeof(VkRectLayerKHR) != damage->rectangleCount)
+         return false;
+      job.rectangles = malloc(bytes);
+      if (!job.rectangles)
+         return false;
+      memcpy(job.rectangles, damage->pRectangles, bytes);
+      job.damage.rectangleCount = damage->rectangleCount;
+      job.damage.pRectangles = job.rectangles;
+   }
+   mtx_lock(&w->lock);
+   if (w->stopping || w->error != VK_SUCCESS || w->count == w->capacity) {
+      mtx_unlock(&w->lock);
+      free(job.rectangles);
+      return false;
+   }
+   w->jobs[(w->head + w->count) % w->capacity] = job;
+   w->count++;
+   cnd_signal(&w->changed);
+   mtx_unlock(&w->lock);
+   return true;
+}
+#endif
