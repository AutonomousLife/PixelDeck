+/* Default-off worker: GPU completion precedes every Wayland publication. */
+static VkResult
+wsi_wl_deferred_prepare(void *data, uint32_t index)
+{
+   struct wsi_wl_swapchain *chain = data;
+   VkResult result = chain->base.wsi->WaitForFences(
+      chain->base.device, 1, &chain->base.fences[index], true, UINT64_MAX);
+   if (result != VK_SUCCESS)
+      return result;
+   return wsi_invalidate_cpu_image(&chain->base, &chain->images[index].base);
+}
+static VkResult
+wsi_wl_deferred_publish(void *data, uint32_t index,
+                         const VkPresentRegionKHR *damage)
+{
+   struct wsi_wl_swapchain *chain = data;
+   VkResult result = wsi_wl_swapchain_queue_present(&chain->base, index, 0, damage);
+   if ((result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) &&
+       chain->base.wsi->set_memory_ownership)
+      chain->base.wsi->set_memory_ownership(chain->base.device,
+                                            chain->images[index].base.memory, false);
+   return result;
+}
+static void
+wsi_wl_deferred_finished(void *data, uint32_t index)
+{
+   struct wsi_wl_swapchain *chain = data;
+   /* The compositor can release before queue_present returns. Both release
+    * and this worker completion are required before the image/fence is reused. */
+   p_atomic_set(&chain->images[index].deferred_pending, false);
+}
+static VkResult
+wsi_wl_defer_present(struct wsi_swapchain *base, uint32_t index,
+                      uint64_t present_id, const VkPresentRegionKHR *damage,
+                      bool *accepted)
+{
+   struct wsi_wl_swapchain *chain = (struct wsi_wl_swapchain *)base;
+   *accepted = false;
+   VkResult error = wsi_deferred_error(&chain->deferred);
+   if (error != VK_SUCCESS)
+      return error;
+   if (!chain->deferred.initialized)
+      return VK_SUCCESS;
+   if (present_id || base->present_timing.active || base->present_wait_enabled ||
+       base->present_mode != VK_PRESENT_MODE_MAILBOX_KHR ||
+       chain->buffer_type != WSI_WL_BUFFER_NATIVE || base->image_info.explicit_sync ||
+       chain->retired || chain->timing_request.serial) {
+      wsi_wl_deferred_stop(chain);
+      return wsi_deferred_error(&chain->deferred);
+   }
+   assert(index < base->image_count);
+   assert(!p_atomic_read(&chain->images[index].deferred_pending));
+   p_atomic_set(&chain->images[index].deferred_pending, true);
+   if (!wsi_deferred_enqueue(&chain->deferred, index, damage)) {
+      p_atomic_set(&chain->images[index].deferred_pending, false);
+      /* Drain earlier publications before synchronous fallback preserves order. */
+      wsi_wl_deferred_stop(chain);
+      return wsi_deferred_error(&chain->deferred);
+   }
+   if (!chain->deferred_reported) {
+      fprintf(stderr, "pixel-wsi: first deferred mailbox publication queued\n");
+      chain->deferred_reported = true;
+   }
+   *accepted = true;
+   return VK_SUCCESS;
+}
