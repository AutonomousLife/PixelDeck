+// All access is serialized by wlserver_lock. A dead pointer is only a map key;
+// it is never dereferenced, including when a later surface reuses its address.
+struct SurfaceLifetime
+{
+	uint64_t serial;
+	std::set<struct wl_resource *> presentation_feedbacks;
+};
+static std::unordered_map<struct wlr_surface *, SurfaceLifetime> g_LiveSurfaces;
+
+uint64_t wlserver_surface_serial( struct wlr_surface *surface )
+{
+	assert( wlserver_is_lock_held() );
+	auto iter = g_LiveSurfaces.find( surface );
+	assert( iter != g_LiveSurfaces.end() && iter->second.serial );
+	return iter->second.serial;
+}
+
+bool wlserver_surface_is_alive( struct wlr_surface *surface, uint64_t serial )
+{
+	assert( wlserver_is_lock_held() );
+	auto iter = g_LiveSurfaces.find( surface );
+	return serial && iter != g_LiveSurfaces.end() && iter->second.serial == serial;
+}
