+		// A Vulkan WSI backend can present on non-DRM GPUs such as Android kbase.
+		// Keep the DRM path when available, for dma-buf clients and direct backends.
+		if ( !drmProps.hasRender && GetBackend()->UsesVulkanSwapchain() ) {
+			vk_log.infof( "Using Vulkan swapchain without a DRM render node" );
+		} else {
+			if ( !GetBackend()->UsesVulkanSwapchain() && !drmProps.hasPrimary ) {
+				vk_log.errorf( "physical device has no primary node" );
