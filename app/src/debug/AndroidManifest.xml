<?xml version="1.0" encoding="utf-8"?>
<!--
  Agent control exists only in debug builds (docs/agent-control.md). The release manifest must not
  declare these components; tools/tests/test_release_manifest.py checks that.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".agent.AgentStartActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/SessionTheme" />

        <provider
            android:name=".agent.AgentBridgeProvider"
            android:authorities="${applicationId}.agent"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:grantUriPermissions="false" />
    </application>
</manifest>
